POSTGRES_DB=metis
POSTGRES_USER=metis
# Set a strong local password before starting Compose. No default password is supplied.
POSTGRES_PASSWORD=
ALPHA_VANTAGE_API_KEY=
MARKET_DAILY_LIMIT=20
MARKET_MIN_INTERVAL_SECONDS=15
MARKET_CACHE_HOURS=12
PROVIDER_TIMEOUT_SECONDS=12
PROVIDER_RETRIES=0
# Live ingestion is forced off in the default Compose file. Enabling it requires
# a deliberate reviewed Compose override AND explicit authorization for each operation.
LIVE_INGESTION_ENABLED=false
MARKET_MINUTE_LIMIT=4
MARKET_JOB_LIMIT=2
METIS_TRAINING_TIMEOUT_SECONDS=300
METIS_ALLOW_FIXTURES=false
